# ============================================================
# ARNA GRAM UNNAYA FOUNDATION
# Environment Configuration
# ============================================================

# ============================================================
# GEMINI AI API
# ============================================================
#
# The ARNA Android application does not require the Gemini API
# for Customer, Employee, or Admin login and dashboards.
#
# Keep this disabled unless Gemini functionality is intentionally
# added to the application.
#
# NEVER commit a real API key to Git or package it directly
# inside the Android APK.
#

# GEMINI_API_KEY=


# ============================================================
# ARNA BACKEND
# ============================================================
#
# The Android application communicates with the ARNA PHP REST API.
# Android must NOT connect directly to MySQL.
#

ARNA_API_BASE_URL=https://arnafoundation.com/api/


# ============================================================
# APPLICATION
# ============================================================

ARNA_APP_NAME=ARNA GRAM UNNAYA FOUNDATION
ARNA_APPLICATION_ID=com.arnafoundation.app


# ============================================================
# ENVIRONMENT
# ============================================================

APP_ENV=production